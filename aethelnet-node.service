[Unit]
Description=Aethelnet LGNN Node Daemon
After=network.target

[Service]
Type=simple
User=aethelnet
Group=aethelnet
WorkingDirectory=/opt/aethelnet-node
Environment="PATH=/opt/aethelnet-node/.venv/bin"
Environment="PYTHONPATH=/opt/aethelnet-node"
ExecStart=/opt/aethelnet-node/.venv/bin/uvicorn aethelnet_node.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

# Hardening
ProtectSystem=full
PrivateDevices=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
