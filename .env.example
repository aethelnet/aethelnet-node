# Copy to .env (git-ignored) and fill in. Never commit the real .env.

# Required for any write request that does not come directly from localhost.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AETHELNET_AUTH_TOKEN=

# Comma-separated list of allowed browser origins for the dashboard.
# Leave empty / "*" to allow all origins (credentials are then disabled).
AETHELNET_CORS_ORIGINS=http://localhost:5173

# Optional shared secret for node-to-node gossip (/p2p/*). All peers must use the same value.
AETHELNET_PEER_TOKEN=

# Comma-separated bootstrap peers, e.g. "peer1.example.org:8000,10.0.0.5:8000"
AETHELNET_PEERS=

# Token of the uplink node, if AETHELNET_UPLINK_URL is used.
AETHELNET_UPLINK_URL=
AETHELNET_UPLINK_TOKEN=

# Allow NaaS nodes (APP:Python / APP:Lua) to execute code. Off by default.
# Only enable on a private node that nobody else can write to.
AETHELNET_ALLOW_CODE_EXEC=0

# ERC-4337 micro-bundler (python -m aethelnet_node.bundler)
# Relayer wallet key that pays gas for handleOps. Required; there is no fallback.
# Use a dedicated, low-balance wallet and never commit the key.
AETHELNET_BUNDLER_KEY=
AETHELNET_RPC_URL=https://sepolia.gateway.tenderly.co
# Localhost by default; only expose it behind auth/firewall.
AETHELNET_BUNDLER_HOST=127.0.0.1
# Comma-separated browser origins allowed to call the bundler (empty = none)
AETHELNET_BUNDLER_CORS_ORIGINS=
# Where forge_client sends UserOps
AETHELNET_BUNDLER_URL=http://127.0.0.1:3000/rpc
